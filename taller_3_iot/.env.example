# Lab 3 — plantilla de variables de entorno. Copiar a `.env` (NO versionar).
# NUNCA pegar valores reales en archivos versionados ni en la bitácora.
# El SAS token se genera EN MEMORIA por mqtt_explicito.py (HMAC-SHA256, con
# expiración); nunca se guarda en disco ni se loguea.

# Hostname del hub asignado por DPS (lo captura la Etapa 1; formato:
# iotc-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.azure-devices.net)
IOT_HUB_HOSTNAME=

# Device ID creado en Azure IoT Central (no reutilizar el del nodo de la VM si
# se quiere evitar mezcla de telemetría)
DEVICE_ID=

# Primary key del device (la del portal IoT Central > Device connection)
DEVICE_PRIMARY_KEY=

# Intervalo de publicación de telemetría (segundos)
INTERVALO_SEGUNDOS=10

# Valor de la propiedad ID_salon reportada
ID_SALON=A-301

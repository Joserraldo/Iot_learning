# Taller 4 — Lab 4: AMQP + CoAP vs MQTT hacia IoT Central
# Plantilla de variables de entorno. Copiar a .env (NO versionar).
# NUNCA pegar valores reales en archivos versionados ni en la bitácora.

# ===== App IoT Central =====
# URL base de la app (sin https:// y sin barra final)
IOT_CENTRAL_APP=clima-salones-app-jose.azureiotcentral.com

# Tokens SAS de la app (Administration → API tokens)
# Se usan SOLO para el provisionamiento vía REST (crear devices, leer credenciales).
IOT_CENTRAL_TOKEN_ADMIN=SharedAccessSignature sr=...
IOT_CENTRAL_TOKEN_OPERATOR=SharedAccessSignature sr=...
IOT_CENTRAL_TOKEN_BUILDER=SharedAccessSignature sr=...

# ===== Hub asignado por DPS =====
# NOTA: la app fue recreada en Lab 4; el idScope real (0ne0128155B) lo devuelve
# el endpoint de credenciales del device (provision_devices.py lo usa vía REST).
IOT_HUB_HOSTNAME=iotc-47a415d3-3f15-4cf1-918c-4be1461915f3.azure-devices.net
ID_SCOPE=0ne0128155B

# ===== Device MQTT baseline (Lab 4; el device del Lab 3 ya no existe) =====
MQTT_DEVICE_ID=mqtt-baseline-01
MQTT_DEVICE_PRIMARY_KEY=

# ===== Device AMQP (Lab 4, creado por provision_devices.py) =====
AMQP_DEVICE_ID=amqp-lab4-01
AMQP_DEVICE_PRIMARY_KEY=

# ===== Device CoAP gateway (Lab 4, creado por provision_devices.py) =====
COAP_DEVICE_ID=coap-gateway-01
COAP_DEVICE_PRIMARY_KEY=

# ===== Plantilla =====
# MODEL_ID de la plantilla consola-unab-ambiental (Lab 2/3)
MODEL_ID=dtmi:unabAmbientalJose:consolaUnabAmbiental_1pu;1

# ===== Intervalos =====
INTERVALO_SEGUNDOS=10

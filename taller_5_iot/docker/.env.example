# Copiar a .env (misma carpeta) y rellenar. NUNCA commitear este archivo real.
# Los secretos se generan en la VM:  openssl rand -hex 24

GRAFANA_ADMIN_PASSWORD=<elije-una>

INFLUX_ORG=unab
INFLUX_BUCKET=telemetria
INFLUX_USERNAME=iot
INFLUX_PASSWORD=<elije-una>
INFLUX_API_TOKEN=<token-admin-aleatorio>
# Token SOLO-LECTURA para Grafana (se crea con la API de Influx, ver README):
INFLUX_TOKEN_READER=<token-lectura>

# Brevo (SMTP) para el email de la alerta:
# BREVO_EMAIL = el USUARIO RELAY que Brevo asigna (GET /v3/account ->
# relay.data.userName, p.ej. b8cab8001@smtp-brevo.com) — NO el email de la cuenta
# BREVO_SMTP_KEY = la "SMTP key" del panel (xsmtpsib-...), NO la API key REST
BREVO_EMAIL=<usuario-relay-smtp-brevo-com>
BREVO_SMTP_KEY=<smtp-relay-key>
# FROM del correo (si, puede ser el email propio):
BREVO_FROM=<email-proPIO>
ALERT_TO_EMAIL=<email-destino-de-la-alerta>

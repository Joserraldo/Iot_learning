    # --- Lab 5: pagina didactica y Grafana (insertar ANTES de location /) ---
    location /taller5/grafana/ {
        proxy_pass http://127.0.0.1:3000;          # SIN URI: preserva el subpath
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
    location /taller5/ {
        proxy_pass http://127.0.0.1:8090/;         # CON /: recorta el prefijo
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

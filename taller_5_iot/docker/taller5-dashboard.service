[Unit]
Description=Lab5 dashboard didactico (plataforma propia)
After=network.target docker.service

[Service]
User=azureuser
WorkingDirectory=/home/azureuser/taller_5_iot/dashboard
Environment=PYTHONUNBUFFERED=1
Environment=EVIDENCIAS=/home/azureuser/taller_5_iot/evidencias
ExecStart=/home/azureuser/taller_4_iot/.venv/bin/gunicorn -w 1 --threads 2 -b 127.0.0.1:8090 "app:app"
Restart=always
KillMode=process

[Install]
WantedBy=multi-user.target
